# Ports of the HTTP API and the web UI
PORT=8080
SERVER_PORT=8081
# cuda on an NVIDIA GPU; cpu anywhere (the default, as in the README). Applies to the
# separators and transcribers. Lyrics (Whisper) run on the CPU unless
# LYRICS_DEVICE=cuda, which works where CTranslate2 has a CUDA build (x86 Linux).
DEVICE=cpu
LYRICS_DEVICE=cpu
